{#-
  Base template.  It owns every cross-cutting concern exactly once: bounds,
  priors, hyperparameters, the relevance weighting, and the shared parts of
  generated quantities.  A likelihood partial overrides a handful of blocks and
  nothing else.

  Two rules are enforced structurally rather than by review:
    * Only STRUCTURE reaches this template.  Bound values and hyperparameter
      values are Stan `data`, so a user editing a number never recompiles, and
      user input never reaches the C++ compiler.
    * Priors attach only to variables declared in `parameters`, never to a
      transformed parameter, and bounds are declared only where Stan can
      enforce them.
-#}
// GENERATED by pirao -- do not edit by hand.
// likelihood : {{ lik.id }}
{%- for p in params %}
// {{ "%-10s"|format(p.name) }} ({{ p.role }}) ~ {{ p.family }}, bounds {{ p.bounds_label }}
{%- endfor %}
functions {
{%- block functions %}{% endblock %}
  /**
   * Reliability at `t`: the probability of surviving that far.  For a
   * demand-based model `t` counts demands rather than time.
   *
   * Each likelihood defines this ONCE and the program uses it for both the
   * mission-time report and the dense curve, so the number quoted in the
   * summary table and the curve drawn through it cannot disagree.
   */
  real reliability_at(real t, {% for a in lik.stan_arg_order %}real {{ a }}{{ ", " if not loop.last }}{% endfor %}) {
{%- block reliability %}{% endblock %}
  }
}
data {
{%- if lik.mission == 'time' %}
  int<lower=0> M;                              // mission times to report at
  array[M] real<lower=0> mission_time;
  int<lower=0> G;                              // points on the reliability curve
  array[G] real<lower=0> curve_time;
{%- else %}
  int<lower=0> mission_demands;
  int<lower=0> G;                              // points on the reliability curve
  array[G] real<lower=0> curve_demands;
{%- endif %}
  int<lower=0> prior_only;                     // 1 = skip the likelihood

  // ---- tidy observation table: one row per observation ----
  int<lower=0> N;
{% block obs_columns %}{% endblock %}
  array[N] real<lower=0, upper=1> relevance;   // fractional-likelihood weight
{% for p in params %}
  // ---- {{ p.name }}: bounds and {{ p.family }} hyperparameters, as data ----
{%- if p.has_lower %}
  real {{ p.lb_name }};
{%- endif %}
{%- if p.has_upper %}
  real {{ p.ub_name }};
{%- endif %}
{%- for h in p.hypers %}
  real{{ h.stan_constraint }} {{ h.stan_name }};   // {{ h.comment }}
{%- endfor %}
{% endfor -%}
}
transformed data {
  if (N > 0 && sum(relevance) <= 0)
    reject("every row has a relevance of 0, so there is nothing to learn from");
{%- for p in params %}
{%- if p.has_lower and p.has_upper %}
  if ({{ p.lb_name }} >= {{ p.ub_name }})
    reject("the lower bound on {{ p.name }} must be below its upper bound");
{%- endif %}
{%- endfor %}
{% block extra_checks %}{% endblock %}
}
parameters {
{%- for p in params %}
  {{ p.declaration }}
{%- endfor %}
}
model {
  // ---- priors, fully normalised so lp__ stays comparable across families ----
{%- for p in params %}
{%- if p.prior_statement %}
  {{ p.prior_statement }}
{%- endif %}
{%- endfor %}

  if (prior_only == 0) {
    // ---- relevance-weighted (fractional) likelihood ----
    // The `relevance > 0` guard is not decoration: 0 * (-inf) is NaN, and a
    // NaN target kills the chain, whereas -inf merely rejects one proposal.
{% block likelihood %}{% endblock %}
  }
}
generated quantities {
{%- if lik.mission == 'time' %}
  vector<lower=0, upper=1>[M] reliability;     // survival at each mission time
  for (m in 1 : M) reliability[m] = reliability_at(mission_time[m], {{ args }});
{%- else %}
  real<lower=0, upper=1> reliability = reliability_at(mission_demands, {{ args }});
{%- endif %}
  // The curve behind the picture.  Its grid arrives as data, so moving the
  // horizon costs a resample and never a recompile.
  vector<lower=0, upper=1>[G] reliability_curve;
{%- if lik.mission == 'time' %}
  for (g in 1 : G) reliability_curve[g] = reliability_at(curve_time[g], {{ args }});
{%- else %}
  for (g in 1 : G) reliability_curve[g] = reliability_at(curve_demands[g], {{ args }});
{%- endif %}
{%- block gq %}{% endblock %}
{%- if emit_log_lik %}
  // Unweighted, so standard LOO/WAIC remain meaningful; the weighted version
  // is what reconciles with `target`.
  vector[N] log_lik;
  vector[N] log_lik_weighted;
  for (i in 1 : N) {
    log_lik[i] = {% block loglik %}{% endblock %};
    log_lik_weighted[i] = relevance[i] * log_lik[i];
  }
{%- endif %}
}
